# Copia este archivo a .env y ajusta los valores. El .env NUNCA se sube al repositorio.

# --- Aplicación ---
ENTORNO=desarrollo

# --- Base de datos (PostgreSQL vía docker compose) ---
POSTGRES_USER=transport
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=transportexperience
POSTGRES_PORT=5432
ADMINER_PORT=8080
# Usa 127.0.0.1 y no "localhost": en Windows "localhost" prueba primero IPv6 y tarda
# varios segundos en caer a IPv4, porque el puerto solo se publica en IPv4.
DATABASE_URL=postgresql+psycopg://transport:cambia_esta_clave@127.0.0.1:5432/transportexperience
# Base de los tests, en el mismo contenedor. pytest la crea sola si no existe.
DATABASE_URL_PRUEBAS=postgresql+psycopg://transport:cambia_esta_clave@127.0.0.1:5432/transportexperience_pruebas

# --- Seguridad (JWT) ---
# OBLIGATORIO cambiarlo: la app no arranca con este valor ni con menos de 32 caracteres.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambia_este_secreto
JWT_MINUTOS_EXPIRACION=60

# --- Frontend (CORS): orígenes que pueden llamar a la API, separados por comas ---
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200

# --- Rastreo GPS: "simulador" o "dispositivo" ---
GPS_FUENTE=simulador

# --- Pagos: "falso" (tests, sin red) o "wompi" (solo sandbox) ---
PAGOS_PROVEEDOR=falso
# Solo llaves de prueba: deben empezar por pub_test_ y prv_test_
WOMPI_LLAVE_PUBLICA=pub_test_xxxxxxxx
WOMPI_LLAVE_PRIVADA=prv_test_xxxxxxxx
WOMPI_SECRETO_EVENTOS=test_events_xxxxxxxx
