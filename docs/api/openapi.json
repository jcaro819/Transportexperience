                {
                  "type": "null"
                }
              ],
              "description": "Busca en nombre y correo.",
              "title": "Busqueda"
            },
            "description": "Busca en nombre y correo."
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Número de página, desde 1.",
              "default": 1,
              "title": "Pagina"
            },
            "description": "Número de página, desde 1."
          },
          {
            "name": "tamano",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Elementos por página (máx. 100).",
              "default": 20,
              "title": "Tamano"
            },
            "description": "Elementos por página (máx. 100)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pagina_UsuarioRespuesta_"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado o sesión expirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "403": {
            "description": "El rol no tiene permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      },
