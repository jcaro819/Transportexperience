{
  "openapi": "3.1.0",
  "info": {
    "title": "TransportExperience API",
    "description": "\nBackend del MVP de TransportExperience: alquiler, venta y domicilio de ciclas, patines y\nmonopatines eléctricos.\n\n**Autenticación.** `POST /autenticacion/token` con un formulario `username` (el correo) y\n`password`. Envía el `access_token` recibido en el encabezado `Authorization: Bearer <token>`.\nEn esta página, usa el botón **Authorize**.\n\n**Errores.** Todas las respuestas de error tienen la forma\n`{\"error\": {\"codigo\", \"mensaje\", \"accion\", \"detalles\"}}`. Decide por `codigo`; muestra\n`mensaje` y `accion` al usuario.\n\n**Listas.** Siempre paginadas: parámetros `pagina` (desde 1) y `tamano` (máx. 100).\n",
    "version": "0.1.0"
  },
  "paths": {
    "/autenticacion/token": {
      "post": {
        "tags": [
          "autenticación"
        ],
        "summary": "Iniciar sesión",
        "description": "Recibe un formulario (``application/x-www-form-urlencoded``) con ``username`` = el\ncorreo y ``password``. Devuelve el token para enviar en ``Authorization: Bearer``.",
        "operationId": "iniciar_sesion_autenticacion_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_iniciar_sesion_autenticacion_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenAcceso"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado o sesión expirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "403": {
            "description": "El rol no tiene permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    },
